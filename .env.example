# App
NEXT_PUBLIC_APP_NAME=Meals Planner
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (local self-hosted baseline)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-dev-service-role-key

# Supabase local containers
POSTGRES_PASSWORD=postgres
JWT_SECRET=replace-with-a-long-random-jwt-secret
KONG_HTTP_PORT=8000
SUPABASE_STUDIO_PORT=3001
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=supabase

# Local auth bootstrap/recovery
AUTH_STATE_FILE=.data/auth-state.json
AUTH_AUDIT_LOG_FILE=.data/auth-audit.log
AUTH_SETUP_TOKEN_TTL_MINUTES=30
AUTH_RESET_TOKEN_TTL_MINUTES=15
AUTH_MIN_PASSWORD_LENGTH=12
# Optional: persist first-run setup token to file for installer workflows
# AUTH_SETUP_TOKEN_FILE=.data/setup-token.txt

# Meal library local storage
MEAL_LIBRARY_STATE_FILE=.data/meal-library.json
