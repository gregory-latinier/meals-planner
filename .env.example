# Local development environment variables
# Copy to .env and fill in values

# --- Database (Postgres runs in Docker, app runs on host) ---
DATABASE_URL=postgresql://mpuser:mppassword@localhost:5432/mealsplanner

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-generate-a-random-64-char-hex-string

# --- Realtime ---
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
CLIENT_URL=http://localhost:3100

# --- App ---
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# --- AI Key Encryption ---
# Used to encrypt household-scoped Gemini API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HOUSEHOLD_GEMINI_KEY_ENCRYPTION_SECRET=change-me-generate-a-random-64-char-hex-string

# --- Household Setup ---
# Used by the seed script to create the initial household password
# Change this before running: pnpm db:seed
HOUSEHOLD_PASSWORD=change-me-before-running-seed

# ---------------------------------------------------------------------------
# Production-only variables (used in .env.prod, not needed for local dev)
# ---------------------------------------------------------------------------

# Postgres credentials (used by docker-compose.prod.yml)
# POSTGRES_USER=mpuser
# POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# POSTGRES_DB=mealsplanner

# Public URL of the deployed app (used by Next.js + Socket.IO CORS)
# NEXT_PUBLIC_APP_URL=https://meals.example.com

# Docker images published to GHCR (used by docker-compose.prod.yml)
# Built and pushed automatically by GitHub Actions on every push to main
# WEB_IMAGE=ghcr.io/gregory-latinier/meals-web:latest
# REALTIME_IMAGE=ghcr.io/gregory-latinier/meals-realtime:latest
