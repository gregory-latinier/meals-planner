# Local development environment variables
# Copy to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql://mpuser:mppassword@localhost:5432/mealsplanner

# --- Server / API ---
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=./uploads

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-generate-a-random-64-char-hex-string

# --- AI Key Encryption ---
# Used to encrypt household-scoped Gemini API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HOUSEHOLD_GEMINI_KEY_ENCRYPTION_SECRET=change-me-generate-a-random-64-char-hex-string

# Optional fallback Gemini API key (can also be entered in Settings UI)
# GEMINI_API_KEY=

# --- Household Setup ---
# Used by the seed script to create the initial household password
# Change this before running: pnpm db:seed
HOUSEHOLD_PASSWORD=change-me-before-running-seed
