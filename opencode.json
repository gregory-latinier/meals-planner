{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "product-discovery",

  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}",
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  },
  "permission": {
    "bash": {
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git fetch *": "allow",
      "gh repo view *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh label list *": "allow",
      "gh project list *": "allow",
      "gh project view *": "allow",
      "gh project item-list *": "allow",
      "gh project item-add *": "allow",
      "gh project item-edit *": "allow",
      "gh project item-create *": "allow",
      "gh project field-list *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push *": "allow",
      "git tag *": "allow",
      "gh issue *": "allow",
      "gh pr *": "allow",
      "gh project *": "allow",
      "gh repo create *": "allow",
      "gh release create *": "allow",
      "gh secret *": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "docker *": "allow",
      "docker compose *": "allow",
      "*": "allow"
    },
    "edit": "allow",
    "webfetch": "allow"
  },
  "agent": {
    "maintainer-ops": {
      "prompt": "Operate autonomously for approved tasks. Do not emit dry-run confirmation tables or ask follow-up confirmation questions when the orchestrator has already provided approval. Execute safe repository and GitHub operations directly and report results.",
      "permission": {
        "bash": {
          "gh project *": "allow",
          "gh issue *": "allow",
          "gh pr *": "allow",
          "gh repo view *": "allow",
          "git status": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "*": "allow"
        },
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow"
      }
    },
    "implementer": {
      "permission": {
        "bash": {
          "npm *": "allow",
          "npx *": "allow",
          "node *": "allow",
          "prisma *": "allow",
          "docker *": "allow",
          "docker compose *": "allow",
          "git status": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "git fetch *": "allow",
          "git branch *": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git push *": "allow",
          "git tag *": "allow",
          "gh issue *": "allow",
          "gh pr *": "allow",
          "gh project *": "allow",
          "gh repo *": "allow",
          "gh branch *": "allow",
          "*": "ask"
        },
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow"
      }
    }
  }
}
