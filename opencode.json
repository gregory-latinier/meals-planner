{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "product-discovery",

  "skills": {
    "paths": [".opencode/skills"]
  },

  "permission": {
    "bash": {
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git fetch *": "allow",
      "gh repo view *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh label list *": "allow",
      "gh project list *": "allow",
      "gh project view *": "allow",
      "gh project item-list *": "allow",
      "gh project item-add *": "allow",
      "gh project item-edit *": "allow",
      "gh project item-create *": "allow",
      "gh project field-list *": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git tag *": "ask",
      "gh repo create *": "ask",
      "gh release create *": "ask",
      "gh secret *": "ask",
      "npm publish *": "ask",
      "npx *": "ask",
      "*": "ask"
    },
    "edit": "ask",
    "webfetch": "allow"
  }
}
