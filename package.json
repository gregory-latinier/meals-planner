{
  "name": "meals-planner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "next lint",
    "test": "pnpm run test:setup && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm run test:setup && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm run lint && pnpm run test:coverage && pnpm run test:e2e",
    "test:setup": "pnpm run test:prisma:generate && pnpm run test:prisma:push",
    "test:prisma:generate": "prisma generate --schema prisma/schema.test.prisma",
    "test:prisma:push": "prisma db push --schema prisma/schema.test.prisma --skip-generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
