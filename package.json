{
  "name": "meals-planner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "concurrently -n server,client -c green,blue \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "dev:db": "docker compose up -d",
    "dev:db:down": "docker compose down",
    "dev:db:logs": "docker compose logs -f db",
    "build": "pnpm --filter server build && pnpm --filter client build",
    "test": "pnpm --filter server test",
    "db:migrate": "pnpm --filter server migrate:up",
    "db:seed": "pnpm --filter server seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
