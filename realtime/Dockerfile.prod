FROM node:20-alpine AS builder
WORKDIR /app
# Inject ZScaler CA so pnpm installs succeed behind corporate proxy
COPY zscaler-ca.crt /usr/local/share/ca-certificates/zscaler-ca.crt
RUN apk add --no-cache ca-certificates wget && update-ca-certificates
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/zscaler-ca.crt
RUN corepack enable && corepack prepare pnpm@10.10.0 --activate
# Copy workspace root files for lockfile
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY realtime/package.json ./realtime/
# Install only realtime dependencies
RUN pnpm install --frozen-lockfile --filter realtime
COPY realtime ./realtime
WORKDIR /app/realtime
RUN ../node_modules/.bin/tsc

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache wget
COPY --from=builder /app/realtime/package.json ./package.json
COPY --from=builder /app/realtime/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
EXPOSE 3001
CMD ["node", "dist/index.js"]
