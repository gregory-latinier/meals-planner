FROM node:20-alpine AS builder
WORKDIR /app

# Optional: inject a corporate CA cert (e.g. Zscaler) for builds behind TLS inspection.
# Pass base64-encoded PEM via:  --build-arg EXTRA_CA_CERT_B64="$(base64 -w0 zscaler-ca.crt)"
# Leave empty (default) for CI / builds that don't need it.
ARG EXTRA_CA_CERT_B64=""
RUN apk add --no-cache ca-certificates wget openssl && \
    if [ -n "$EXTRA_CA_CERT_B64" ]; then \
      echo "$EXTRA_CA_CERT_B64" | base64 -d > /usr/local/share/ca-certificates/extra-ca.crt && \
      update-ca-certificates; \
    fi
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

RUN corepack enable && corepack prepare pnpm@10.10.0 --activate
# Copy workspace root files for lockfile
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY web/package.json ./web/
# Copy schema before install so prisma postinstall can find it
COPY web/prisma ./web/prisma
# Install deps (postinstall runs prisma generate here)
RUN pnpm install --frozen-lockfile --filter web
# Copy remaining sources
COPY web/src ./web/src
COPY web/public ./web/public
COPY web/next.config.ts web/tsconfig.json web/postcss.config.mjs web/eslint.config.mjs ./web/
# Build Next.js
WORKDIR /app/web
RUN ../node_modules/.bin/next build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache wget
COPY --from=builder /app/web/public ./public
COPY --from=builder /app/web/.next/standalone ./
COPY --from=builder /app/web/.next/static ./.next/static
COPY --from=builder /app/web/prisma ./prisma
COPY --from=builder /app/node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0/node_modules/@prisma/client ./node_modules/@prisma/client
EXPOSE 3000
ENV PORT=3000
CMD ["node", "server.js"]
